APP_ENV=development
API_BASE_URL=http://localhost:8000
DATASET_KEY=timerapp-v1

# SharePoint / Microsoft Graph (required for live ingestion)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_HOST=tenant.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/TimerApp
SHAREPOINT_SOURCE_LISTS=TimerList_AllProject01,TimerList_AllProject02,TimerList_AllProject03,TimerList_AllProject04

# Existing TimerApp lists are the production source. Local remains a developer fixture only;
# both modes publish immutable Bronze rows and governance data to Dataverse.
DATA_SOURCE_PROVIDER=sharepoint
LOCAL_DATASET_PATH=/app/sample-data/ecommerce-v1
SOURCE_MAX_LISTS=4
SOURCE_MAX_FILE_BYTES=26214400
SOURCE_MAX_ROWS=5000
MAXIMUM_EVIDENCE_ROWS=100

# Microsoft Dataverse environment (organization URL, no trailing API path)
DATAVERSE_URL=https://your-environment.crm.dynamics.com
DATAVERSE_API_VERSION=v9.2
