APP_ENV=development
API_BASE_URL=http://localhost:8000
DATASET_KEY=ecommerce-v1

# SharePoint / Microsoft Graph (required for live ingestion)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_HOST=tenant.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/AIDataQualityDev
SHAREPOINT_LIBRARY=DataQualityDatasets
SHAREPOINT_DATASET_FOLDER=GenericDatasets/ecommerce-v1

# Use local for a zero-credential demo, sharepoint for the real source path.
DATA_SOURCE_PROVIDER=local
ORCHESTRATION_MODE=local
LOCAL_DATASET_PATH=/app/sample-data/ecommerce-v1

# Bronze S3 / SeaweedFS
BRONZE_S3_ENDPOINT=http://seaweedfs:8333
BRONZE_S3_BUCKET=bronze
BRONZE_S3_ACCESS_KEY=seaweed
BRONZE_S3_SECRET_KEY=seaweed
BRONZE_PREFIX=sharepoint/GenericDatasets/ecommerce-v1

# ClickHouse
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Airflow API
AIRFLOW_API_URL=http://airflow:8080/api/v1
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_DAG_ID=sharepoint_generic_dataset_bronze_ingestion

# Optional LLM suggestions
GENERIC_LLM_RULES_ENABLED=false
GROQ_API_KEY=
